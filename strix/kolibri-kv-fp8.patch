+/* FP8 KV rows (opt-in, full-attention layers): each (row, KV head) holds D
+ * E4M3 codes, and a float per (row, head) after all codes holds
+ * max|x| / 448 * 256, so that the code's bits shifted into f16 (value / 256,
+ * exact) times it give the value back. */
+__device__ __forceinline__ unsigned f32_to_e4m3(float f) {
+    const unsigned sign = f < 0 ? 0x80u : 0u;
+    const float a = fminf(fabsf(f), 448.0f);
+    if (a < 0.015625f) return sign | (unsigned)rintf(a * 512.0f);   /* subnormal; 8 rounds up to 2^-6 */
+    int e;
+    const float fr = frexpf(a, &e);                                  /* a = fr * 2^e, fr in [0.5, 1) */
+    unsigned m = (unsigned)rintf((fr * 2.0f - 1.0f) * 8.0f);
+    int ex = e - 1;
+    if (m == 8) { m = 0; ex++; }
+    return sign | min(((unsigned)(ex + 7) << 3) | m, 0x7Eu);
+}
